# (SnarkjsGroth16JsonKatTest, SnarkjsPlonkJsonKatTest). Keep their line endings LF on every
# checkout so a core.autocrlf=true clone cannot fail those tests for a non-semantic reason.
zeroj-test-vectors/src/main/resources/test-vectors/**/*.json text eol=lf
