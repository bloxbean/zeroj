---
const { siteTitleHref } = Astro.locals.starlightRoute;
---

<a class="brand" href={siteTitleHref} aria-label="ZeroJ home">
  <img class="mark" src="/zeroj-icon.svg" width="30" height="30" alt="" />
  <span class="wordmark" translate="no">zeroj</span>
  <span class="slash" aria-hidden="true">/</span>
  <span class="caption">ZK FOR THE JVM</span>
</a>

<style>
  .brand {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: 10px;
    color: var(--sl-color-white);
    text-decoration: none;
    white-space: nowrap;
  }

  .mark {
    width: 30px;
    height: 30px;
    flex: 0 0 auto;
  }

  .wordmark {
    font-family: var(--zj-font-display);
    font-size: 1.6rem;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .slash {
    padding-inline: 4px;
    color: var(--sl-color-gray-4);
    font-family: var(--zj-font-display);
    font-size: 1.5rem;
    font-weight: 300;
    line-height: 1;
  }

  .caption {
    color: var(--sl-color-gray-3);
    font-family: var(--zj-font-mono);
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.18em;
  }

  @media (max-width: 50rem) {
    .slash,
    .caption {
      display: none;
    }
  }
</style>
