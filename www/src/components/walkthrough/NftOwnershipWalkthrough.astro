---
// Private NFT ownership, step by step: register -> snapshot -> prove -> access -> reuse rejected.
// Values follow the nft-ownership demo's `demo.sh --run` (circuit version 2, ADR-0009 D2): the app draws a
// 252-bit holder secret, registers token ZeroJTicket_1 with a CIP-8 signature from the custody wallet that
// holds it, builds a depth-10 snapshot for the event "nft-demo-v1" (application.yml zk.default-context), and
// deploys the event's scripts with the root and context as parameters. Hashes and the secret are
// illustrative stand-ins (see fakeHash).
//
// The one interaction compares nullifier versions: version 2 (now) absorbs the holder secret; version 1
// (before) was Poseidon(tokenName, contextId), which anyone could recompute for every token.
import './walkthrough.css';
import { fakeHash } from './engine';

const secretKey = fakeHash('nft-holder-secret-252');
const tokenName = 'ZeroJTicket_1';
const contextId = 'nft-demo-v1';
const snapshotRoot = fakeHash('nft-snapshot-root');
const nullifiers = {
  v2: fakeHash(`nf2:${secretKey}:${tokenName}:${contextId}`),
  v1: fakeHash(`nf1:${tokenName}:${contextId}`),
};

// A depth-3 tree drawn for the picture (the demo's tree has depth 10, up to 1,024 holders). The holder's
// leaf is leaf 2; the Merkle path is the siblings along leaf 2 -> node 1 -> node 0 -> root.
const W = 320;
const leafX = (i: number) => 20 + i * 40;
const levels = [
  Array.from({ length: 8 }, (_, i) => ({ x: leafX(i), y: 118 })),
  Array.from({ length: 4 }, (_, i) => ({ x: (leafX(2 * i) + leafX(2 * i + 1)) / 2, y: 80 })),
  Array.from({ length: 2 }, (_, i) => ({ x: (leafX(4 * i) + leafX(4 * i + 3)) / 2, y: 46 })),
  [{ x: W / 2, y: 14 }],
];
const onPath = [2, 1, 0, 0];
const sibling = [3, 0, 1, -1];
const edges = levels.slice(0, 3).flatMap((level, l) =>
  level.map((n, i) => ({ from: n, to: levels[l + 1][Math.floor(i / 2)], path: onPath[l] === i })),
);
---

<figure class="zw-frame not-content" aria-label="Private NFT ownership, step by step">
  <div class="zw znf" data-total="5" data-view="insider" data-nf="v2">
    <div class="zw-head">
      <span class="zw-eyebrow">NFT ownership · step <b data-counter>1 / 5</b></span>
      <div class="zw-tools">
        <div class="zw-seg" role="group" aria-label="Whose view">
          <button type="button" data-view-btn="insider" aria-pressed="true">Holder's view</button>
          <button type="button" data-view-btn="public" aria-pressed="false">Public view</button>
        </div>
        <button type="button" class="zw-btn" data-present aria-pressed="false">Present</button>
      </div>
    </div>

    <div class="zw-stage">
      <!-- indexer -->
      <section class="zw-actor" data-hl="1,2" aria-label="Indexer">
        <div class="zw-actor-head">
          <span class="zw-actor-name">Indexer</span>
          <span class="zw-actor-sub">event snapshot</span>
        </div>
        <div class="zw-box">
          <span class="zw-box-title">Registrations · one per token</span>
          <ol class="znf-list">
            <li class="you" data-hl="1">
              <code>{tokenName}</code><span class="znf-ok">CIP-8 ✓</span>
            </li>
            <li class="znf-refused" data-show="1">
              <code>{tokenName}</code><span class="znf-no">again: refused</span>
            </li>
          </ol>
          <span class="zw-note" data-show="1">Signed by the address that holds the token on-chain.</span>
          <span class="zw-check" data-show="2-5">registration closed when the snapshot was built</span>
        </div>
        <svg class="znf-tree" viewBox={`0 0 ${W} 132`} role="img"
          aria-label="A Merkle tree of registered leaves. Only the root is published.">
          {edges.map((e) => (
            <line x1={e.from.x} y1={e.from.y} x2={e.to.x} y2={e.to.y} class={e.path ? 't-edge on-path' : 't-edge'} />
          ))}
          {levels.map((level, l) =>
            level.map((n, i) => {
              const isLeaf = l === 0;
              const cls = [
                't-node',
                isLeaf && i > 4 ? 'empty' : '',
                onPath[l] === i ? 'on-path' : '',
                sibling[l] === i ? 'sib' : '',
                isLeaf && i === 2 ? 'you' : '',
                l === 3 ? 'root' : '',
              ].join(' ');
              return <circle cx={n.x} cy={n.y} r={l === 3 ? 12 : isLeaf ? 11 : 8} class={cls} />;
            }),
          )}
          <text x={leafX(2)} y="99" class="t-you-tag" data-when="insider">you</text>
        </svg>
        <p class="zw-note">Each leaf is <code>Poseidon(Poseidon(s, 0), t)</code>, which hides the token. The demo's tree has depth 10 (up to 1,024 holders).</p>
        <div class="zw-row" data-kind="public" data-show="2-5" data-hl="2">
          <span class="k">snapshotRoot</span><em class="zw-tag">PUBLIC</em>
          <span class="v">{snapshotRoot}</span>
        </div>
        <p class="zw-note znf-trust">Trust point: one use per registration rests on the indexer admitting one leaf per token, from its holder. It can't see which token a leaf commits to.</p>
      </section>

      <div class="zw-wire" data-dir="left" data-hl="1" aria-hidden="true">
        <span class="arrow" data-show="1">←</span>
        <span class="zw-wire-line"></span>
        <span class="zw-msg" data-show="1">leaf + CIP-8 signature</span>
      </div>

      <!-- holder device -->
      <section class="zw-actor" data-hl="1,3" data-bad="5" aria-label="Holder's device">
        <div class="zw-actor-head">
          <span class="zw-actor-name" data-when="insider">Holder</span>
          <span class="zw-actor-name" data-when="public">A holder</span>
          <span class="zw-actor-sub" data-when="insider">wallet stays unconnected</span>
          <span class="zw-actor-sub" data-when="public">wallet hidden</span>
        </div>
        <div class="zw-row" data-kind="secret" data-hl="1">
          <span class="k">secretKey s · 252-bit</span><em class="zw-tag"><span class="vis">SECRET</span><span class="hid">HIDDEN</span></em>
          <span class="v"><span class="real">{secretKey}</span><span class="mask">████████</span></span>
        </div>
        <div class="zw-row" data-kind="secret" data-hl="1">
          <span class="k">tokenName t</span><em class="zw-tag"><span class="vis">SECRET</span><span class="hid">HIDDEN</span></em>
          <span class="v"><span class="real">{tokenName}</span><span class="mask">████████</span></span>
          <span class="znf-leak" data-when="public" data-nfmode="v1" data-show="4-5">matchable from the nullifier</span>
        </div>
        <div class="zw-row" data-kind="secret" data-hl="3">
          <span class="k">Merkle path</span><em class="zw-tag"><span class="vis">SECRET</span><span class="hid">HIDDEN</span></em>
          <span class="v"><span class="real">10 sibling hashes</span><span class="mask">████████</span></span>
        </div>
        <div class="zw-box" data-show="1">
          <span class="zw-box-title">Signs with the holding address's key</span>
          <code class="znf-formula">(contextId, tokenName, leaf)</code>
        </div>
        <div class="znf-design">
          <span class="znf-design-label">nullifier</span>
          <span class="zw-choice" role="group" aria-label="Nullifier version">
            <button type="button" data-nf-btn="v2" aria-pressed="true">version 2</button>
            <button type="button" data-nf-btn="v1" aria-pressed="false">version 1</button>
          </span>
          <span class="zw-note" data-nfmode="v2">the demo now</span>
          <span class="zw-note" data-nfmode="v1">the demo before</span>
        </div>
        <div class="znf-prove" data-show="3" aria-hidden="true">
          <svg class="zw-rings" viewBox="0 0 128 128">
            <path class="r1" d="M116.28 43.93A56 56 0 1 1 29.76 19.69"></path>
            <path class="r2" d="M45.87 98.53A39 39 0 1 1 94.31 39.46"></path>
            <path class="r3" d="M55.21 43.29A22.5 22.5 0 0 1 80.18 79.63"></path>
          </svg>
          <span>Proving in pure Java</span>
        </div>
        <div class="zw-row" data-kind="public" data-show="3-5" data-hl="3" data-bad="5">
          <span class="k" data-nfmode="v2">nullifier = Poseidon(Poseidon(s, t), contextId)</span>
          <span class="k" data-nfmode="v1">nullifier = Poseidon(t, contextId)</span>
          <em class="zw-tag">PUBLIC</em>
          <span class="v" data-nfmode="v2">{nullifiers.v2}</span>
          <span class="v" data-nfmode="v1">{nullifiers.v1}</span>
        </div>
        <div class="zw-proof" data-show="3-4">
          <span class="pi">π</span><span>Groth16 proof</span><small>192 bytes</small>
        </div>
        <p class="zw-note znf-again" data-show="5">Second access with the same leaf: the <b>same nullifier</b>.</p>
      </section>

      <div class="zw-wire" data-hl="4" data-bad="5" aria-hidden="true">
        <span class="arrow" data-show="4-5">→</span>
        <span class="zw-wire-line"></span>
        <span class="zw-msg" data-show="4">π + nullifier</span>
        <span class="zw-msg" data-show="5">same nullifier</span>
      </div>

      <!-- Cardano -->
      <section class="zw-actor" data-hl="2,4" data-bad="5" aria-label="Cardano">
        <div class="zw-actor-head">
          <span class="zw-actor-name">Cardano</span>
          <span class="zw-actor-sub">access gate for this event</span>
        </div>
        <span class="zw-note" data-show="1">The event's scripts are deployed when the snapshot is built.</span>
        <div class="zw-box" data-show="2-5">
          <span class="zw-box-title"><code>ZkProofMintingPolicy</code></span>
          <span class="znf-param"><span>parameter</span><code>snapshotRoot</code></span>
          <span class="znf-param"><span>parameter</span><code>contextId = {contextId}</code></span>
          <span class="zw-check" data-show="4-5">Groth16 over <code>[root, context, 1, nullifier]</code></span>
          <span class="zw-check" data-show="4-5">mints exactly 1 token named <code>nullifier</code></span>
        </div>
        <div class="zw-box" data-show="2-5">
          <span class="zw-box-title"><code>NullifierListValidator</code> · sorted list</span>
          <ol class="znf-list">
            <li class="root" data-hl="2"><code>root node</code><span class="znf-tagline">seed spent: once</span></li>
            <li class="you" data-show="4-5" data-hl="4">
              <code data-nfmode="v2">{nullifiers.v2}</code>
              <code data-nfmode="v1">{nullifiers.v1}</code>
              <span class="znf-new" data-show="4">inserted</span>
            </li>
          </ol>
          <span class="zw-note" data-show="2-3">No accesses yet: only the root node.</span>
          <span class="zw-check" data-show="4">new key = the proved nullifier</span>
          <span class="zw-check" data-show="4">nodes are never removed</span>
          <span class="zw-check no" data-show="5">insert fails: already in the list</span>
        </div>
        <div class="zw-box" data-show="4-5">
          <span class="zw-box-title">Can anyone link it?</span>
          <span class="zw-check" data-nfmode="v2">not to a token or wallet: the nullifier absorbs the holder's 252-bit secret</span>
          <span class="zw-check no" data-nfmode="v1">yes: hashing every token name with <code>{contextId}</code> finds {tokenName}, and so the wallet that holds it</span>
        </div>
      </section>
    </div>

    <div class="zw-narr" aria-live="polite">
      <div data-show="1">
        <p class="zw-narr-title">1. Register</p>
        <p>The app draws a 252-bit holder secret <code>s</code> and registers the leaf <code>Poseidon(Poseidon(s, 0), t)</code> for token <code>t</code>. The registration is signed (CIP-8) by the address that holds the token on-chain. The indexer takes one registration per token, so a second one for {tokenName} is refused.</p>
      </div>
      <div data-show="2">
        <p class="zw-narr-title">2. Build the snapshot</p>
        <p>The indexer builds the Merkle tree and publishes the root, and registration closes. The event's scripts are deployed with the root and <code>contextId</code> as parameters, and the nullifier list's root is created once, by spending a seed UTxO.</p>
      </div>
      <div data-show="3">
        <p class="zw-narr-title">3. Prove</p>
        <p>The holder finds the Merkle path to its leaf, computes the nullifier for this event, and proves the leaf is in the snapshot without saying which one. Switch to <b>Public view</b> to see what leaves the device.</p>
      </div>
      <div data-show="4">
        <p class="zw-narr-title">4. Access</p>
        <p data-nfmode="v2">The transaction mints one token named after the nullifier. The policy verifies the proof against its own root and context, and the list inserts a node whose key is that nullifier. Nobody can tell which NFT was used. Switch to <b>version 1</b> to see why the old nullifier leaked.</p>
        <p data-nfmode="v1">Version 1 hashed only the token name and the event. Both are public, so anyone could hash every token name of the collection and match this nullifier: it named the NFT, and so the wallet. Version 2 adds the holder's secret.</p>
      </div>
      <div data-show="5">
        <p class="zw-narr-title">5. Reuse is rejected</p>
        <p data-nfmode="v2">The same leaf in the same event gives the same nullifier. It's already in the list, so the insert fails and the transaction is rejected. Because the indexer admitted one leaf per token, that's one use per registration.</p>
        <p data-nfmode="v1">Version 1 also caught a second use, since the same NFT always gave the same nullifier. But the old list didn't tie its new key to the proved nullifier and let nodes be removed, so a nullifier could be inserted again.</p>
      </div>
    </div>

    <div class="zw-foot">
      <ol class="zw-steps" aria-label="Steps">
        <li><button type="button" data-goto="1"><span>1</span>Register</button></li>
        <li><button type="button" data-goto="2"><span>2</span>Snapshot</button></li>
        <li><button type="button" data-goto="3"><span>3</span>Prove</button></li>
        <li><button type="button" data-goto="4"><span>4</span>Access</button></li>
        <li><button type="button" data-goto="5"><span>5</span>Reuse</button></li>
      </ol>
      <div class="zw-ctrl">
        <button type="button" class="zw-btn" data-prev aria-label="Previous step">←</button>
        <button type="button" class="zw-btn" data-play aria-pressed="false">Play</button>
        <button type="button" class="zw-btn" data-next aria-label="Next step">→</button>
      </div>
    </div>
    <div class="zw-legend">
      <span><em class="zw-tag secret">SECRET</em> stays with the holder</span>
      <span><em class="zw-tag public">PUBLIC</em> visible to anyone on Cardano</span>
      <span>The secret and hash values are illustrative.</span>
    </div>
  </div>
</figure>

<script>
  import { initWalkthrough } from './engine';

  document.querySelectorAll<HTMLElement>('.znf').forEach((root) => {
    initWalkthrough(root);
    root.querySelectorAll<HTMLButtonElement>('[data-nf-btn]').forEach((b, _, all) =>
      b.addEventListener('click', () => {
        root.dataset.nf = b.dataset.nfBtn;
        all.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      }),
    );
  });
</script>

<style>
  /* the nullifier version switch: show only the chosen variant */
  .znf[data-nf='v2'] [data-nfmode='v1'],
  .znf[data-nf='v1'] [data-nfmode='v2'] {
    display: none !important;
  }

  .znf-tree {
    width: 100%;
    height: auto;
    max-height: 8.5em;
  }

  .znf-tree .t-edge {
    stroke: var(--zw-line);
    stroke-width: 2.5;
  }

  .znf-tree .t-node {
    fill: var(--zw-bg);
    stroke: var(--zw-muted);
    stroke-width: 2.5;
    transition:
      fill 0.3s,
      stroke 0.3s;
  }

  .znf-tree .t-node.empty {
    stroke-dasharray: 3 3;
    stroke: var(--zw-line);
  }

  .znf-tree .t-node.root {
    fill: var(--zw-public);
    stroke: var(--zw-public);
  }

  /* before the snapshot is built, the root isn't fixed yet */
  .zw[data-step='1'] .znf-tree .t-node.root {
    fill: var(--zw-bg);
    stroke: var(--zw-line);
    stroke-dasharray: 3 3;
  }

  .znf-tree .t-you-tag {
    font: 700 17px var(--zw-mono);
    text-anchor: middle;
    fill: var(--zw-secret);
  }

  /* holder's view: their leaf; step 3 adds the path they prove and its (secret) siblings */
  .zw:not([data-view='public']) .znf-tree .t-node.you {
    fill: var(--zw-secret);
    stroke: var(--zw-secret);
  }

  .zw[data-step='3']:not([data-view='public']) .znf-tree .t-edge.on-path {
    stroke: var(--zw-secret);
    stroke-width: 5;
  }

  .zw[data-step='3']:not([data-view='public']) .znf-tree .t-node.sib {
    fill: color-mix(in srgb, var(--zw-secret) 25%, var(--zw-bg));
    stroke: var(--zw-secret);
    stroke-dasharray: 3 2;
  }

  .zw[data-step='2'] .znf-tree .t-node.root {
    animation: znf-pulse 1.6s ease-in-out infinite;
  }

  .znf-trust {
    padding: 0.4em 0.55em;
    color: var(--zw-warn-ink);
    background: var(--zw-warn-bg);
    border-radius: 8px;
  }

  .znf-leak {
    flex-basis: 100%;
    font: 600 0.72em var(--zw-mono);
    color: var(--zw-bad-ink);
  }

  .znf-formula {
    font-size: 0.74em;
    overflow-wrap: anywhere;
  }

  .znf-param {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.2em 0.45em;
    font-size: 0.78em;
    overflow-wrap: anywhere;
  }

  .znf-param > span {
    font: 500 0.9em var(--zw-mono);
    color: var(--zw-muted);
  }

  .znf-design {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.3em 0.5em;
    padding: 0.4em 0.5em;
    border: 1px dashed var(--zw-line);
    border-radius: 8px;
  }

  .znf-design-label {
    font: 500 0.75em var(--zw-mono);
    color: var(--zw-muted);
  }

  .znf-prove {
    display: flex;
    align-items: center;
    gap: 0.6em;
    font-size: 0.8em;
    color: var(--zw-text-2);
  }

  .znf-again {
    padding: 0.4em 0.55em;
    color: var(--zw-bad-ink);
    background: var(--zw-bad-bg);
    border-radius: 8px;
  }

  .znf-list {
    display: flex;
    flex-direction: column;
    gap: 0.3em;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .znf-list li {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.2em 0.4em;
    padding: 0.25em 0.5em;
    font-size: 0.8em;
    overflow-wrap: anywhere;
    border: 1px solid var(--zw-line);
    border-radius: 7px;
  }

  .znf-list li.root {
    color: var(--zw-muted);
    border-style: dashed;
  }

  .znf-list li.you {
    border-color: var(--zw-public);
    animation: zw-in 0.4s ease-out;
  }

  .znf-list li.znf-refused {
    color: var(--zw-bad-ink);
    border-color: var(--zw-bad);
    border-style: dashed;
  }

  .zw[data-step='5'] .zw-actor .znf-list li.you[data-show] {
    border-color: var(--zw-bad);
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--zw-bad) 20%, transparent);
  }

  .znf-new,
  .znf-ok {
    font: 600 0.8em var(--zw-mono);
    color: var(--zw-public);
  }

  .znf-no {
    font: 600 0.8em var(--zw-mono);
    color: var(--zw-bad-ink);
  }

  .znf-tagline {
    font: 600 0.8em var(--zw-mono);
    color: var(--zw-muted);
  }

  @keyframes znf-pulse {
    50% {
      stroke-width: 6;
      stroke: color-mix(in srgb, var(--zw-public) 40%, transparent);
    }
  }
</style>
