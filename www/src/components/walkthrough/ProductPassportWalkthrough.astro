---
// Digital product passport, step by step (zeroj-usecases ADR-0009 D1):
// commit -> prove -> co-sign -> mint -> read -> revoke.
// Values follow the digital-product-passport demo (battery packs BAT-SN001..003 from
// BatteryAssembly GmbH; carbon <= 50 kg CO2e gated on-chain). Blindings and commitment points are
// illustrative stand-ins (see fakeHash), not Jubjub points.
import './walkthrough.css';
import { fakeHash } from './engine';
import {
  BATTERIES,
  CARBON_MAX_KG,
  CHOSEN_THRESHOLD,
  CLAIMS,
  MANUFACTURER,
  canMint,
  claims,
  measurement,
} from './product-passport-data';

const product = BATTERIES[0];
const ok = claims(product);
const mintable = canMint(product);
const blinding = (key: string, id: string) => fakeHash(`r:${key}:${id}`);
const point = (key: string, id: string, value: string) => fakeHash(`C:${key}:${id}:${value}`);
const rings = [
  'M116.28 43.93A56 56 0 1 1 29.76 19.69',
  'M45.87 98.53A39 39 0 1 1 94.31 39.46',
  'M55.21 43.29A22.5 22.5 0 0 1 80.18 79.63',
];
---

<figure class="zw-frame not-content" aria-label="Digital product passport, step by step">
  <div class="zw zpp" data-total="6" data-view="insider" data-ok={String(mintable)}>
    <div class="zw-head">
      <span class="zw-eyebrow">Product passport · step <b data-counter>1 / 6</b></span>
      <div class="zw-tools">
        <div class="zw-seg" role="group" aria-label="Whose view">
          <button type="button" data-view-btn="insider" aria-pressed="true">Auditor &amp; manufacturer</button>
          <button type="button" data-view-btn="public" aria-pressed="false">Chain observer</button>
        </div>
        <button type="button" class="zw-btn" data-present aria-pressed="false">Present</button>
      </div>
    </div>

    <div class="zw-stage">
      <!-- auditor -->
      <section class="zw-actor" data-hl="1,3,6" aria-label="Auditor">
        <div class="zw-actor-head">
          <span class="zw-actor-name">Auditor</span>
          <span class="zw-actor-sub">measures, commits, co-signs</span>
        </div>
        <div class="zpp-pick">
          <span class="zpp-pick-label">Product</span>
          <span class="zw-choice" role="group" aria-label="Battery pack">
            {BATTERIES.map((b, i) => (
              <button type="button" data-product={b.id} aria-pressed={i === 0 ? 'true' : 'false'}>{b.short}</button>
            ))}
          </span>
        </div>
        <p class="zw-note" data-pp="name">{product.name}</p>
        {CLAIMS.map((c) => (
          <div class="zw-row" data-kind="secret" data-hl="1">
            <span class="k">{c.key}</span><em class="zw-tag"><span class="vis">SECRET</span><span class="hid">HIDDEN</span></em>
            <span class="v"><span class="real" data-pp={`m-${c.key}`}>{measurement(product, c.key)}</span><span class="mask">████████</span></span>
          </div>
        ))}
        <div class="zw-row" data-kind="secret" data-show="1-2" data-hl="1">
          <span class="k">blinding r per claim (fresh, 252 bits)</span><em class="zw-tag"><span class="vis">SECRET</span><span class="hid">HIDDEN</span></em>
          <span class="v"><span class="real" data-pp="r-carbon">{blinding('carbon', product.id)}</span><span class="mask">████████</span></span>
        </div>
        <div class="zw-row" data-kind="public" data-show="1-6" data-hl="1">
          <span class="k">C · carbon = (u, v)</span><em class="zw-tag">COMMITMENT</em>
          <span class="v" data-pp="c-carbon">{point('carbon', product.id, measurement(product, 'carbon'))}</span>
        </div>
        <div class="zw-box zpp-if-ok" data-show="3" data-hl="3">
          <span class="zw-box-title">CoSignGuard, before signing</span>
          <span class="zw-check">datum = exactly my commitments for this product</span>
          <span class="zw-check">mint is exactly {'{'}productId: 1{'}'}, one output at the passport address</span>
          <span class="zw-check">my key authorises nothing else</span>
          <span class="zw-check">a TTL is set (the demo uses 180 slots); mint history for the product is empty</span>
          <span class="zw-check">reserve the product for this tx, then sign</span>
        </div>
        <p class="zw-note zpp-if-bad" data-show="3-4">Never asked to co-sign: the script refuses the transaction in local evaluation first.</p>
        <p class="zw-note" data-show="6">Only the auditor can revoke: it signs a burn of {'{'}productId: −1{'}'}.</p>
      </section>

      <div class="zw-wire" data-hl="1,3" aria-hidden="true">
        <span class="arrow" data-show="1-2">→</span>
        <span class="arrow" data-show="3">←</span>
        <span class="zw-wire-line"></span>
        <span class="zw-msg" data-show="1-2">opening (m, r)</span>
        <span class="zw-msg" data-show="3">tx to co-sign</span>
      </div>

      <!-- manufacturer -->
      <section class="zw-actor" data-hl="2,3" aria-label="Manufacturer">
        <div class="zw-actor-head">
          <span class="zw-actor-name">Manufacturer</span>
          <span class="zw-actor-sub">{MANUFACTURER}</span>
        </div>
        <p class="zw-note" data-show="1">Waits for the auditor's report and openings.</p>
        <div class="zw-row" data-kind="secret" data-show="2-6">
          <span class="k">openings (m, r), 4 claims</span><em class="zw-tag"><span class="vis">SECRET</span><span class="hid">HIDDEN</span></em>
          <span class="v"><span class="real">from the auditor</span><span class="mask">████████</span></span>
        </div>
        <div class="zpp-proving" data-show="2" aria-hidden="true">
          <svg class="zw-rings" viewBox="0 0 128 128">
            {rings.map((d, i) => <path class={`r${i + 1}`} d={d}></path>)}
          </svg>
          <span>Groth16, one proof per claim</span>
        </div>
        <div class="zpp-claims" data-show="2-6">
          {CLAIMS.map((c) => (
            <span class={ok[c.key] ? 'zw-check' : 'zw-check no'} data-claim={c.key}>
              {c.rule}: <b>{ok[c.key] ? 'proved' : 'no proof exists'}</b>
              <small class="zpp-cc"> · {c.circuit}, {c.constraints} constraints</small>
            </span>
          ))}
        </div>
        <div class="zw-box" data-show="3" data-hl="3">
          <span class="zw-box-title">Passport transaction</span>
          <span class="zw-note zpp-if-ok">Mints the token <code data-pp="tx-pid">{product.id}</code> to the passport address, with every commitment in its datum. The redeemer carries only the carbon proof.</span>
          <span class="zw-check warn zpp-if-bad">No carbon proof for ≤ {CARBON_MAX_KG} kg. "Skip off-chain check" builds the transaction with a proof for ≤ {CHOSEN_THRESHOLD.toLocaleString('en-US')} instead.</span>
        </div>
      </section>

      <div class="zw-wire zpp-w2" data-hl="4" aria-hidden="true">
        <span class="arrow" data-show="4">→</span>
        <span class="zw-wire-line"></span>
        <span class="zw-msg" data-show="4"><span class="zpp-if-ok">signed tx</span><span class="zpp-if-bad">not submitted</span></span>
      </div>

      <!-- Cardano -->
      <section class="zw-actor zpp-chain" data-hl="4,5,6" aria-label="Cardano">
        <div class="zw-actor-head">
          <span class="zw-actor-name">Cardano</span>
          <span class="zw-actor-sub">DppPassport · Plutus V3</span>
        </div>
        <p class="zw-note" data-show="1-3">No passport yet. Nothing is published before the mint.</p>
        <div class="zw-box" data-show="4">
          <span class="zw-box-title"><span class="zpp-if-ok">Mint checks</span><span class="zpp-if-bad">Mint checks, in local evaluation</span></span>
          <span class="zw-check">(a) manufacturer and auditor both signed</span>
          <span class="zw-check">(b) mint map is exactly {'{'}productId: 1{'}'}</span>
          <span class="zw-check">(c) one output at the passport address, exact datum</span>
          <span class={mintable ? 'zw-check' : 'zw-check no'} data-pp="policy-proof">
            {mintable ? `(d) proof verifies against [σ, u, v, ${CARBON_MAX_KG}]` : `(d) proof fails against [σ, u, v, ${CARBON_MAX_KG}]: refused, nothing submitted`}
          </span>
          <span class="zw-note zpp-if-ok">27.9 % of the CPU budget</span>
        </div>
        <div class="zw-box zpp-if-ok" data-show="4-6">
          <span class="zw-box-title">Passport · locked at its own address</span>
          <div class="zw-row" data-kind="public">
            <span class="k">productId</span><em class="zw-tag">PUBLIC</em>
            <span class="v" data-pp="pid">{product.id}</span>
          </div>
          <div class="zw-row" data-kind="public">
            <span class="k">manufacturerPkh</span><em class="zw-tag">PUBLIC</em>
            <span class="v">{fakeHash('manufacturer-pkh')}</span>
          </div>
          <div class="zw-row" data-kind="public">
            <span class="k">claims: 4 × (id, σ, u, v)</span><em class="zw-tag">PUBLIC</em>
            <span class="v" data-pp="pc">{point('carbon', product.id, measurement(product, 'carbon'))} …</span>
          </div>
        </div>
        <div class="zw-box zpp-if-ok" data-show="5">
          <span class="zw-box-title">Reader (customs, buyer, regulator)</span>
          <span class="zw-check">token found at the passport address</span>
          <span class="zw-check">mint history: exactly one passport ever</span>
          <span class="zw-check">σ from its own schema registry, never the datum</span>
          <span class="zw-check">off-chain proofs verify against the datum's commitments</span>
        </div>
        <div class="zw-box zpp-if-ok" data-show="6">
          <span class="zw-box-title">Spending the passport</span>
          <span class="zw-check no">transfer it, or change its datum</span>
          <span class="zw-check no">manufacturer revokes</span>
          <span class="zw-check">auditor signs and burns {'{'}productId: −1{'}'}</span>
        </div>
        <span class="zw-check no zpp-if-bad" data-show="4-6">
          No passport for <b data-pp="nopass-id">{product.id}</b>: the script only accepts a proof for its own threshold.
        </span>
      </section>
    </div>

    <div class="zw-narr" aria-live="polite">
      <div data-show="1">
        <p class="zw-narr-title">1. Commit</p>
        <p>The auditor measures the pack. For each claim it draws a fresh 252-bit blinding <code>r</code> and computes a <code>pedersen-jubjub-vector-v1</code> commitment <code>C = (u, v)</code> under the claim's schema. It hands the opening <code>(m, r)</code> to the manufacturer with its report. There is no shared secret: the manufacturer gets only its own product's openings.</p>
      </div>
      <div data-show="2">
        <p class="zw-narr-title">2. Prove</p>
        <p>From the openings, the manufacturer proves each claim's rule against its commitment. Every rule is an assertion, so a claim that doesn't hold has no proof at all. Pick SN003 (65 kg, 20 %) to see two claims with no proof.</p>
      </div>
      <div data-show="3">
        <p class="zw-narr-title">3. Co-sign</p>
        <p>The manufacturer builds one passport transaction. Before co-signing, the auditor checks that the datum holds exactly its own commitments for this product, that the transaction mints one token and spends nothing of the auditor's, and that no passport for the product was ever minted. It reserves the product, then signs, so it signs at most one passport per product. The transaction is first run through the script locally, so a transaction the script refuses never reaches the auditor.</p>
      </div>
      <div data-show="4">
        <p class="zw-narr-title">4. Mint</p>
        <p><code>DppPassport</code> checks both signatures, the exact mint and output, and the carbon proof against its own <code>σ</code> and threshold (50 kg), never values the manufacturer picks. The passport is locked at the script's own address with every commitment in its datum. For SN003 the forced proof is for a different threshold: the demo runs the script locally before the auditor co-signs, the script refuses it, and nothing is submitted.</p>
      </div>
      <div data-show="5">
        <p class="zw-narr-title">5. Read</p>
        <p>A reader finds the passport on-chain, refuses the product if more than one passport was ever minted, takes each schema digest from its own registry and verifies the other three claims against the datum's commitments. Switch to <b>Chain observer</b>: the commitments are public, the measurements are not.</p>
      </div>
      <div data-show="6">
        <p class="zw-narr-title">6. Revoke</p>
        <p>A passport never moves and its datum never changes. The only way to spend it is a burn the auditor signs, so only the auditor can revoke it.</p>
      </div>
    </div>

    <div class="zw-foot">
      <ol class="zw-steps" aria-label="Steps">
        <li><button type="button" data-goto="1"><span>1</span>Commit</button></li>
        <li><button type="button" data-goto="2"><span>2</span>Prove</button></li>
        <li><button type="button" data-goto="3"><span>3</span>Co-sign</button></li>
        <li><button type="button" data-goto="4"><span>4</span>Mint</button></li>
        <li><button type="button" data-goto="5"><span>5</span>Read</button></li>
        <li><button type="button" data-goto="6"><span>6</span>Revoke</button></li>
      </ol>
      <div class="zw-ctrl">
        <button type="button" class="zw-btn" data-prev aria-label="Previous step">←</button>
        <button type="button" class="zw-btn" data-play aria-pressed="false">Play</button>
        <button type="button" class="zw-btn" data-next aria-label="Next step">→</button>
      </div>
    </div>
    <div class="zw-legend">
      <span><em class="zw-tag secret">SECRET</em> known to the auditor and the manufacturer</span>
      <span><em class="zw-tag public">PUBLIC</em> anyone can read it on Cardano</span>
      <span>Blindings and points are illustrative.</span>
    </div>
  </div>
</figure>

<script>
  import { initWalkthrough, fakeHash } from './engine';
  import { BATTERIES, CARBON_MAX_KG, CLAIMS, canMint, claims, measurement } from './product-passport-data';

  document.querySelectorAll<HTMLElement>('.zpp').forEach((root) => {
    initWalkthrough(root);
    const set = (key: string, text: string) => {
      const el = root.querySelector(`[data-pp="${key}"]`);
      if (el) el.textContent = text;
    };
    const setProduct = (id: string) => {
      const b = BATTERIES.find((x) => x.id === id) ?? BATTERIES[0];
      const ok = claims(b);
      const mintable = canMint(b);
      root.dataset.ok = String(mintable);
      root.querySelectorAll<HTMLElement>('[data-product]').forEach((btn) =>
        btn.setAttribute('aria-pressed', String(btn.dataset.product === b.id)),
      );
      const carbonPoint = fakeHash(`C:carbon:${b.id}:${measurement(b, 'carbon')}`);
      set('name', b.name);
      CLAIMS.forEach((c) => set(`m-${c.key}`, measurement(b, c.key)));
      set('r-carbon', fakeHash(`r:carbon:${b.id}`));
      set('c-carbon', carbonPoint);
      set('pc', `${carbonPoint} …`);
      set('pid', b.id);
      set('tx-pid', b.id);
      set('nopass-id', b.id);
      CLAIMS.forEach((c) => {
        const el = root.querySelector<HTMLElement>(`[data-claim="${c.key}"] b`);
        if (el) el.textContent = ok[c.key] ? 'proved' : 'no proof exists';
        root.querySelector(`[data-claim="${c.key}"]`)?.classList.toggle('no', !ok[c.key]);
      });
      const policy = root.querySelector<HTMLElement>('[data-pp="policy-proof"]');
      if (policy) {
        policy.textContent = mintable
          ? `(d) proof verifies against [σ, u, v, ${CARBON_MAX_KG}]`
          : `(d) proof fails against [σ, u, v, ${CARBON_MAX_KG}]: refused, nothing submitted`;
        policy.classList.toggle('no', !mintable);
      }
    };
    root.querySelectorAll<HTMLButtonElement>('[data-product]').forEach((btn) =>
      btn.addEventListener('click', () => setProduct(btn.dataset.product ?? BATTERIES[0].id)),
    );
  });
</script>

<style>
  .zpp-pick {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4em;
  }

  .zpp-pick-label {
    font: 600 0.72em var(--zw-mono);
    color: var(--zw-muted);
  }

  .zpp-proving {
    display: flex;
    align-items: center;
    gap: 0.6em;
    font-size: 0.8em;
    color: var(--zw-text-2);
  }

  .zpp-claims {
    display: grid;
    gap: 0.35em;
  }

  .zpp-cc {
    font-size: 0.85em;
    color: var(--zw-muted);
  }

  /* a product whose carbon claim fails: the mint is refused and no passport appears */
  .zpp[data-ok='true'] .zpp-if-bad,
  .zpp[data-ok='false'] .zpp-if-ok {
    display: none;
  }

  .zpp[data-ok='false'][data-step='4'] .zpp-chain {
    border-color: var(--zw-bad);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--zw-bad) 18%, transparent);
  }

  .zpp[data-ok='false'][data-step='4'] .zpp-w2 .zw-wire-line {
    background: color-mix(in srgb, var(--zw-bad) 45%, transparent);
  }

  .zpp[data-ok='false'][data-step='4'] .zpp-w2 .zw-wire-line::after {
    background: linear-gradient(90deg, transparent, var(--zw-bad), transparent);
  }

  .zpp[data-ok='false'][data-step='4'] .zpp-w2 .arrow {
    color: var(--zw-bad);
  }

  .zpp[data-ok='false'][data-step='4'] .zpp-w2 .zw-msg {
    color: var(--zw-bad-ink);
    border-color: color-mix(in srgb, var(--zw-bad) 50%, transparent);
  }
</style>
