---
// Private voting, step by step: register -> prove -> submit -> vote again -> tally.
// Values follow the private-voting demo (election "ZeroJ DAO Proposal #1", five voters, voter1 votes
// yes and voter2 votes no). Hashes are illustrative stand-ins (see fakeHash), not Poseidon outputs.
import './walkthrough.css';
import { fakeHash } from './engine';

const election = 'ZeroJ DAO Proposal #1';
const voterRoot = fakeHash('root:voter1..voter5');
const secretKey = fakeHash('sk:voter3');
const nullifier = fakeHash(`nf:${secretKey}:${election}`);
const commitment = (vote: number) => fakeHash(`cm:${vote}:${nullifier}`);

// The on-chain nullifier list before you vote holds voter1's and voter2's nullifiers; yours is
// inserted between its sorted neighbours.
const list = [
  { nf: fakeHash(`nf:voter1:${election}`), you: false },
  { nf: fakeHash(`nf:voter2:${election}`), you: false },
  { nf: nullifier, you: true },
].sort((a, b) => a.nf.localeCompare(b.nf));

// A depth-3 tree drawn for the picture (the demo's tree has depth 10). Leaves 0-4 hold voter1..voter5;
// you are voter3 (leaf 2). Your path goes leaf 2 -> node 1 -> node 0 -> root; the Merkle path is the
// siblings along it.
const W = 320;
const leafX = (i: number) => 20 + i * 40;
const levels = [
  Array.from({ length: 8 }, (_, i) => ({ x: leafX(i), y: 118 })),
  Array.from({ length: 4 }, (_, i) => ({ x: (leafX(2 * i) + leafX(2 * i + 1)) / 2, y: 80 })),
  Array.from({ length: 2 }, (_, i) => ({ x: (leafX(4 * i) + leafX(4 * i + 3)) / 2, y: 46 })),
  [{ x: W / 2, y: 14 }],
];
const onPath = [2, 1, 0, 0];
const sibling = [3, 0, 1, -1];
const edges = levels.slice(0, 3).flatMap((level, l) =>
  level.map((n, i) => ({ from: n, to: levels[l + 1][Math.floor(i / 2)], path: onPath[l] === i })),
);
---

<figure class="zw-frame not-content" aria-label="Private voting, step by step">
  <div class="zw zv" data-total="5" data-view="insider" data-vote="1" data-nullifier={nullifier}>
    <div class="zw-head">
      <span class="zw-eyebrow">Private voting · step <b data-counter>1 / 5</b></span>
      <div class="zw-tools">
        <div class="zw-seg" role="group" aria-label="Whose view">
          <button type="button" data-view-btn="insider" aria-pressed="true">Voter's view</button>
          <button type="button" data-view-btn="public" aria-pressed="false">Public view</button>
        </div>
        <button type="button" class="zw-btn" data-present aria-pressed="false">Present</button>
      </div>
    </div>

    <div class="zw-stage">
      <!-- organizer -->
      <section class="zw-actor" data-hl="1" aria-label="Organizer">
        <div class="zw-actor-head">
          <span class="zw-actor-name">Organizer</span>
          <span class="zw-actor-sub">builds the voter list</span>
        </div>
        <svg class="zv-tree" viewBox={`0 0 ${W} 156`} role="img"
          aria-label="A Merkle tree of five voter public keys. Only the root is published.">
          {edges.map((e) => (
            <line x1={e.from.x} y1={e.from.y} x2={e.to.x} y2={e.to.y} class={e.path ? 't-edge on-path' : 't-edge'} />
          ))}
          {levels.map((level, l) =>
            level.map((n, i) => {
              const leaf = l === 0;
              const cls = [
                't-node',
                leaf && i > 4 ? 'empty' : '',
                onPath[l] === i ? 'on-path' : '',
                sibling[l] === i ? 'sib' : '',
                leaf && i === 2 ? 'you' : '',
                l === 3 ? 'root' : '',
              ].join(' ');
              return <circle cx={n.x} cy={n.y} r={l === 3 ? 12 : leaf ? 11 : 8} class={cls} />;
            }),
          )}
          {[1, 2, 3, 4, 5].map((v, i) => (
            <text x={leafX(i)} y="148" class={i === 2 ? 't-label you' : 't-label'}>pk{v}</text>
          ))}
          <text x={leafX(2)} y="99" class="t-you-tag" data-when="insider">you</text>
        </svg>
        <div class="zw-row" data-kind="public" data-hl="1">
          <span class="k">voterRoot</span><em class="zw-tag">PUBLIC</em>
          <span class="v">{voterRoot}</span>
        </div>
        <div class="zw-row" data-kind="public" data-hl="1">
          <span class="k">electionId</span><em class="zw-tag">PUBLIC</em>
          <span class="v wrap">{election}</span>
        </div>
        <p class="zw-note">5 voters registered. The demo's tree has depth 10 (1,024 slots).</p>
      </section>

      <div class="zw-wire" data-dir="left" data-hl="1" aria-hidden="true">
        <span class="arrow" data-show="1">←</span>
        <span class="zw-wire-line"></span>
        <span class="zw-msg" data-show="1">public key</span>
      </div>

      <!-- voter device -->
      <section class="zw-actor" data-hl="2" data-bad="4" aria-label="Voter's device">
        <div class="zw-actor-head">
          <span class="zw-actor-name" data-when="insider">Your device</span>
          <span class="zw-actor-name" data-when="public">A voter</span>
          <span class="zw-actor-sub" data-when="insider">voter3</span>
          <span class="zw-actor-sub" data-when="public">identity hidden</span>
        </div>
        <div class="zw-row" data-kind="secret" data-hl="1">
          <span class="k">secretKey</span><em class="zw-tag"><span class="vis">SECRET</span><span class="hid">HIDDEN</span></em>
          <span class="v"><span class="real">{secretKey}</span><span class="mask">████████</span></span>
        </div>
        <div class="zw-row" data-kind="secret" data-hl="2">
          <span class="k">Merkle path</span><em class="zw-tag"><span class="vis">SECRET</span><span class="hid">HIDDEN</span></em>
          <span class="v"><span class="real">10 sibling hashes</span><span class="mask">████████</span></span>
        </div>
        <div class="zw-row" data-kind="secret" data-hl="2">
          <span class="k">vote</span><em class="zw-tag"><span class="vis">SECRET</span><span class="hid">HIDDEN</span></em>
          <span class="v">
            <span class="real zw-choice" role="group" aria-label="Your vote">
              <button type="button" data-vote-btn="1" aria-pressed="true">Yes</button>
              <button type="button" data-vote-btn="0" aria-pressed="false">No</button>
            </span>
            <span class="mask">████████</span>
          </span>
        </div>
        <div class="zv-prove" data-show="2" aria-hidden="true">
          <svg class="zw-rings" viewBox="0 0 128 128">
            <path class="r1" d="M116.28 43.93A56 56 0 1 1 29.76 19.69"></path>
            <path class="r2" d="M45.87 98.53A39 39 0 1 1 94.31 39.46"></path>
            <path class="r3" d="M55.21 43.29A22.5 22.5 0 0 1 80.18 79.63"></path>
          </svg>
          <span>Proving in pure Java, on this device</span>
        </div>
        <div class="zw-row" data-kind="public" data-show="2-5" data-hl="2" data-bad="4">
          <span class="k">nullifier = Poseidon(secretKey, electionId)</span><em class="zw-tag">PUBLIC</em>
          <span class="v">{nullifier}</span>
        </div>
        <div class="zw-row" data-kind="public" data-show="2-5" data-hl="2">
          <span class="k">commitment = Poseidon(vote, nullifier)</span><em class="zw-tag">PUBLIC</em>
          <span class="v" data-commitment>{commitment(1)}</span>
        </div>
        <div class="zw-proof" data-show="2-4">
          <span class="pi">π</span><span>Groth16 proof</span><small>192 bytes</small>
        </div>
        <p class="zw-note zv-again" data-show="4">
          Second ballot, <b data-vote-flip>No</b>: same key, so the <b>same nullifier</b>.
        </p>
      </section>

      <div class="zw-wire" data-hl="3" data-bad="4" aria-hidden="true">
        <span class="arrow" data-show="3-4">→</span>
        <span class="zw-wire-line"></span>
        <span class="zw-msg" data-show="3">π + 4 inputs</span>
        <span class="zw-msg" data-show="4">same nullifier</span>
      </div>

      <!-- Cardano -->
      <section class="zw-actor" data-hl="3,5" data-bad="4" aria-label="Cardano">
        <div class="zw-actor-head">
          <span class="zw-actor-name">Cardano</span>
          <span class="zw-actor-sub">Plutus V3 scripts</span>
        </div>
        <div class="zw-box" data-show="3-4">
          <span class="zw-box-title"><code>VoteZkMintingPolicy</code></span>
          <span class="zw-check">Groth16 proof valid</span>
          <span class="zw-check">mints 1 token named <code>nullifier</code></span>
        </div>
        <div class="zw-box">
          <span class="zw-box-title"><code>VoteListValidator</code> · sorted nullifiers</span>
          <ol class="zv-list">
            {list.map((n) => (
              <li class={n.you ? 'you' : ''} data-show={n.you ? '3-5' : undefined} data-hl={n.you ? '3' : undefined}>
                <code>{n.nf}</code>
                {n.you && <span class="zv-new" data-show="3">inserted</span>}
              </li>
            ))}
          </ol>
          <span class="zw-check" data-show="1-2">2 ballots so far (voter1, voter2)</span>
          <span class="zw-check no" data-show="4">insert fails: already in the list</span>
        </div>
        <div class="zw-box zv-tally" data-show="5">
          <span class="zw-box-title">Tally · anyone can count</span>
          <div class="zv-count">
            <span><b data-yes>2</b> Yes</span>
            <span><b data-no>1</b> No</span>
          </div>
          <p class="zw-note">Which voter cast which ballot: unknown. The choice decodes by trying 0 and 1.</p>
        </div>
      </section>
    </div>

    <div class="zw-narr" aria-live="polite">
      <div data-show="1">
        <p class="zw-narr-title">1. Register</p>
        <p>The organizer collects each voter's public key, <code>Poseidon(secretKey, 0)</code>, builds a Merkle tree and publishes only the root and the election ID. Your secret key stays on your device.</p>
      </div>
      <div data-show="2">
        <p class="zw-narr-title">2. Prove</p>
        <p>Your device finds the Merkle path to your key, computes the nullifier and the commitment, and proves that all three come from one key on the list. Switch to <b>Public view</b> to see what leaves the device.</p>
      </div>
      <div data-show="3">
        <p class="zw-narr-title">3. Submit</p>
        <p>The transaction carries the 192-byte proof and four public inputs. The minting policy verifies the proof and mints one token named after the nullifier. The list validator inserts the nullifier between its sorted neighbours.</p>
      </div>
      <div data-show="4">
        <p class="zw-narr-title">4. Vote again</p>
        <p>A second ballot from the same key, even with a different choice, has the same nullifier. It's already in the list, so the insert fails and the transaction is rejected. A different key would give a new nullifier, but that key isn't in the tree.</p>
      </div>
      <div data-show="5">
        <p class="zw-narr-title">5. Tally</p>
        <p>Anyone reads the commitments and counts them, and nobody can tell which voter cast which ballot. In this demo the choice can be decoded by trying 0 and 1, so it gives anonymity, not ballot secrecy (see the note below).</p>
      </div>
    </div>

    <div class="zw-foot">
      <ol class="zw-steps" aria-label="Steps">
        <li><button type="button" data-goto="1"><span>1</span>Register</button></li>
        <li><button type="button" data-goto="2"><span>2</span>Prove</button></li>
        <li><button type="button" data-goto="3"><span>3</span>Submit</button></li>
        <li><button type="button" data-goto="4"><span>4</span>Vote again</button></li>
        <li><button type="button" data-goto="5"><span>5</span>Tally</button></li>
      </ol>
      <div class="zw-ctrl">
        <button type="button" class="zw-btn" data-prev aria-label="Previous step">←</button>
        <button type="button" class="zw-btn" data-play aria-pressed="false">Play</button>
        <button type="button" class="zw-btn" data-next aria-label="Next step">→</button>
      </div>
    </div>
    <div class="zw-legend">
      <span><em class="zw-tag secret">SECRET</em> never leaves the voter's device</span>
      <span><em class="zw-tag public">PUBLIC</em> visible to anyone on Cardano</span>
      <span>Hash values are illustrative.</span>
    </div>
  </div>
</figure>

<script>
  import { initWalkthrough, fakeHash } from './engine';

  document.querySelectorAll<HTMLElement>('.zv').forEach((root) => {
    initWalkthrough(root);
    const nullifier = root.dataset.nullifier ?? '';
    const setVote = (vote: number) => {
      root.dataset.vote = String(vote);
      root.querySelectorAll('[data-vote-btn]').forEach((b) =>
        b.setAttribute('aria-pressed', String(Number((b as HTMLElement).dataset.voteBtn) === vote)),
      );
      const commitment = root.querySelector('[data-commitment]');
      if (commitment) commitment.textContent = fakeHash(`cm:${vote}:${nullifier}`);
      const flip = root.querySelector('[data-vote-flip]');
      if (flip) flip.textContent = vote ? 'No' : 'Yes';
      // voter1 voted yes and voter2 voted no before you.
      const yes = root.querySelector('[data-yes]');
      const no = root.querySelector('[data-no]');
      if (yes) yes.textContent = String(1 + vote);
      if (no) no.textContent = String(1 + (1 - vote));
    };
    root.querySelectorAll<HTMLButtonElement>('[data-vote-btn]').forEach((b) =>
      b.addEventListener('click', () => setVote(Number(b.dataset.voteBtn))),
    );
  });
</script>

<style>
  .zv-tree {
    width: 100%;
    height: auto;
    max-height: 9.5em;
  }

  .zv-tree .t-edge {
    stroke: var(--zw-line);
    stroke-width: 2.5;
  }

  .zv-tree .t-node {
    fill: var(--zw-bg);
    stroke: var(--zw-muted);
    stroke-width: 2.5;
    transition:
      fill 0.3s,
      stroke 0.3s;
  }

  .zv-tree .t-node.empty {
    stroke-dasharray: 3 3;
    stroke: var(--zw-line);
  }

  .zv-tree .t-node.root {
    fill: var(--zw-public);
    stroke: var(--zw-public);
  }

  .zv-tree .t-label {
    font: 600 17px var(--zw-mono);
    text-anchor: middle;
    fill: var(--zw-muted);
  }

  .zv-tree .t-you-tag {
    font: 700 17px var(--zw-mono);
    text-anchor: middle;
    fill: var(--zw-secret);
  }

  /* voter's view: your leaf; step 2 adds the path you prove and its (secret) siblings */
  .zw:not([data-view='public']) .zv-tree .t-node.you {
    fill: var(--zw-secret);
    stroke: var(--zw-secret);
  }

  .zw:not([data-view='public']) .zv-tree .t-label.you {
    fill: var(--zw-secret);
  }

  .zw[data-step='2']:not([data-view='public']) .zv-tree .t-edge.on-path {
    stroke: var(--zw-secret);
    stroke-width: 5;
  }

  .zw[data-step='2']:not([data-view='public']) .zv-tree .t-node.sib {
    fill: color-mix(in srgb, var(--zw-secret) 25%, var(--zw-bg));
    stroke: var(--zw-secret);
    stroke-dasharray: 3 2;
  }

  .zw[data-step='1'] .zv-tree .t-node.root {
    animation: zv-pulse 1.6s ease-in-out infinite;
  }

  .zv-prove {
    display: flex;
    align-items: center;
    gap: 0.6em;
    font-size: 0.8em;
    color: var(--zw-text-2);
  }

  .zv-again {
    padding: 0.4em 0.55em;
    color: var(--zw-bad-ink);
    background: var(--zw-bad-bg);
    border-radius: 8px;
  }

  .zv-list {
    display: flex;
    flex-direction: column;
    gap: 0.3em;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .zv-list li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.4em;
    padding: 0.25em 0.5em;
    font-size: 0.8em;
    border: 1px solid var(--zw-line);
    border-radius: 7px;
  }

  .zv-list li.you {
    border-color: var(--zw-public);
    animation: zw-in 0.4s ease-out;
  }

  .zw[data-step='4'] .zv-list li.you {
    border-color: var(--zw-bad);
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--zw-bad) 20%, transparent);
  }

  .zv-new {
    font: 600 0.8em var(--zw-mono);
    color: var(--zw-public);
  }

  .zv-count {
    display: flex;
    gap: 1.2em;
    font-size: 0.95em;
  }

  .zv-count b {
    font-family: var(--zw-display);
    font-size: 1.6em;
    color: var(--zw-public);
  }

  @keyframes zv-pulse {
    50% {
      stroke-width: 6;
      stroke: color-mix(in srgb, var(--zw-public) 40%, transparent);
    }
  }
</style>
