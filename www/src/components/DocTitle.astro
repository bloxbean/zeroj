---
import PageTitle from '@astrojs/starlight/components/PageTitle.astro';

// Every docs page has a raw Markdown twin under /ai/pages/<slug>.md (see scripts/ai-artifacts.mjs).
const slug = Astro.url.pathname.replace(/^\/+|\/+$/g, '');
const markdown = `/ai/pages/${slug || 'index'}.md`;
const isPage = slug !== '' && slug !== '404' && slug !== '404.html';
---

<PageTitle />
{
  isPage && (
    <div class="page-tools" data-pagefind-ignore>
      <a href={markdown}>
        View Markdown <span aria-hidden="true">↗</span>
      </a>
      <button type="button" data-markdown={markdown}>
        <span aria-hidden="true">✧</span> Copy page for AI
      </button>
      <span class="copy-feedback" role="status" aria-live="polite" />
    </div>
  )
}

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-markdown]').forEach((button) =>
    button.addEventListener('click', async () => {
      const feedback = button.parentElement?.querySelector('.copy-feedback');
      try {
        const response = await fetch(button.dataset.markdown || '');
        if (!response.ok) throw new Error('Markdown unavailable');
        await navigator.clipboard.writeText(await response.text());
        if (feedback) feedback.textContent = 'Copied — paste it into your AI assistant.';
      } catch {
        if (feedback) feedback.textContent = 'Could not copy. Use View Markdown instead.';
      }
      window.setTimeout(() => {
        if (feedback) feedback.textContent = '';
      }, 3000);
    }),
  );
</script>

<style>
  .page-tools {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.9rem;
    font-size: 0.75rem;
    color: var(--sl-color-gray-3);
  }

  .page-tools a {
    color: var(--sl-color-text-accent);
    text-decoration: none;
  }

  .page-tools a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .page-tools button {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.35rem 0.7rem;
    font: inherit;
    color: var(--sl-color-white);
    cursor: pointer;
    background: var(--sl-color-bg-nav);
    border: 1px solid var(--sl-color-hairline-shade);
    border-radius: 999px;
    transition:
      border-color 0.2s,
      color 0.2s;
  }

  .page-tools button:hover {
    border-color: var(--sl-color-accent);
    color: var(--sl-color-accent-high);
  }

  .copy-feedback {
    font-size: 0.7rem;
    color: var(--sl-color-text-accent);
  }
</style>
