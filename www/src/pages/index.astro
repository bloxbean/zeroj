---
import { Code } from 'astro:components';
import '../styles/landing.css';
import { SITE_URL, REPO_URL, USECASES_URL, ZEROJ_VERSION } from '../../site.config.mjs';

const install = `implementation platform('org.zeroj:zeroj-bom-core:${ZEROJ_VERSION}')`;

const pipeline = [
  {
    id: 'define',
    number: '01',
    label: 'Define',
    title: 'Write the rule as a Java class.',
    text: 'Mark inputs @Secret or @Public, return a ZkBool, and the annotation processor generates a typed AgeCheckCircuit companion. No new language to learn.',
    href: '/guides/circuits/annotations/',
    cta: 'Write circuits with annotations',
    file: 'AgeCheck.java',
    code: `@ZKCircuit(name = "age-check", version = 1)
public class AgeCheck {

    @Prove
    ZkBool prove(@Secret @UInt(bits = 8) ZkUInt age,
                 @Public @UInt(bits = 8) ZkUInt threshold) {
        return age.gte(threshold);   // the statement you prove
    }
}`,
    note: 'Range-checked inputs, symbolic types, generated companion',
  },
  {
    id: 'prove',
    number: '02',
    label: 'Prove',
    title: 'Prove it with a pure-Java prover.',
    text: 'Compile to R1CS, compute the witness from typed inputs, and create a Groth16 proof on BLS12-381. No native libraries, no Node.js, no external CLI.',
    href: '/start/quickstart/',
    cta: 'Follow the quickstart',
    file: 'Prover.java',
    code: `var circuit = AgeCheckCircuit.build();
var r1cs = circuit.compileR1CS(CurveId.BLS12_381);
var inputs = AgeCheckCircuit.inputs().age(27).threshold(18);
BigInteger[] witness = inputs.calculateWitness(circuit, CurveId.BLS12_381);

// Dev-only single-party setup (-Dzeroj.allowInsecureTrustedSetup=true).
// Real deployments import keys from a multi-party ceremony.
BigInteger tau = PowersOfTauBLS381.generate(4).tauScalar();
try (var keys = Groth16Keys.setupInMemory(
        r1cs.constraints(), r1cs.numWires(), r1cs.numPublicInputs(), tau)) {
    Groth16ProofBLS381 proof = keys.prove(witness, r1cs.constraints());
}`,
    note: 'Excerpt · the quickstart has the complete, runnable program',
  },
  {
    id: 'verify',
    number: '03',
    label: 'Verify',
    title: 'Verify in any JVM.',
    text: 'The verifier gets the verification key, the proof and the public inputs. It never sees the age — only that the statement holds.',
    href: '/guides/verifying/off-chain/',
    cta: 'Verify proofs in Java',
    file: 'Verifier.java',
    code: `BigInteger[] pub = Arrays.copyOfRange(witness, 1, 1 + r1cs.numPublicInputs());
String vkJson = SnarkjsGroth16Json.verificationKeyJson(keys);
String proofJson = SnarkjsGroth16Json.proofJson(proof);
String publicJson = SnarkjsGroth16Json.publicJson(pub);

CircuitId id = AgeCheckCircuit.circuitId();
var envelope = SnarkjsJsonCodec.toEnvelopeFromJson(proofJson, vkJson, publicJson, id);
var material = VerificationMaterial.of(vkJson.getBytes(UTF_8),
        ProofSystemId.GROTH16, CurveId.BLS12_381, id);

boolean valid = new Groth16BLS12381PureJavaVerifier()
        .verify(envelope, material)
        .proofValid();   // true`,
    note: 'snarkjs-compatible JSON · also verifiable with snarkjs itself',
  },
  {
    id: 'onchain',
    number: '04',
    label: 'On-chain',
    title: 'Verify it on Cardano.',
    text: 'Reusable Plutus V3 validators, written in Java and compiled by JuLC, check the BLS12-381 pairing on-chain. Your validator adds the policy: who may spend, and only once.',
    href: '/tutorials/verify-on-cardano/',
    cta: 'Verify your proof on Cardano',
    file: 'OnChain.java',
    code: `var vk = ProverToCardano.compressVk(keys);
var ic = ListPlutusData.of();
vk.ic().forEach(point -> ic.add(new BytesPlutusData(point)));

// The verification key is baked into the script as parameters.
var script = JulcScriptLoader.load(Groth16BLS12381Verifier.class,
        new BytesPlutusData(vk.alpha()), new BytesPlutusData(vk.beta()),
        new BytesPlutusData(vk.gamma()), new BytesPlutusData(vk.delta()), ic);

// Public inputs go in the datum, the compressed proof in the redeemer.
var p = ProverToCardano.compressProof(proof);   // 48 + 96 + 48 bytes`,
    note: 'A valid proof is not authorization — bind it to the spend',
  },
];

const features = [
  {
    glyph: '{ }',
    title: 'Circuits are just Java',
    text: '@ZKCircuit classes with symbolic ZkField, ZkUInt and ZkBool values. The compiler catches mistakes; generated companions give you typed inputs.',
    href: '/guides/circuits/annotations/',
    cta: 'Annotations guide',
  },
  {
    glyph: 'π',
    title: 'A pure-Java Groth16 prover',
    text: 'Setup, prove and verify on BLS12-381 in pure Java — nothing to install beyond a JDK. GraalVM-friendly, with an optional blst backend when you want it.',
    href: '/guides/proving/groth16/',
    cta: 'Prove with Groth16',
  },
  {
    glyph: '∞',
    title: 'Built for big circuits',
    text: 'Memory-mapped proving keys and a streaming setup keep circuits with millions of constraints on commodity machines.',
    href: '/guides/proving/performance/',
    cta: 'Performance guide',
  },
  {
    glyph: '✓',
    title: 'Verify anywhere',
    text: 'A pluggable verifier SPI for your JVM services, and reusable Plutus V3 validators for Cardano.',
    href: '/guides/verifying/on-chain/',
    cta: 'Verification guides',
  },
  {
    glyph: '#',
    title: 'Real-world gadgets',
    text: 'Poseidon, Merkle membership, comparators — plus in-circuit SHA-512, Blake2b, Ed25519 and CIP-1852 key derivation.',
    href: '/guides/circuits/gadgets/',
    cta: 'Gadget library',
  },
  {
    glyph: '⇄',
    title: 'Plays well with others',
    text: 'Import circom/snarkjs keys and proofs, export snarkjs-compatible JSON, and issue BBS selective-disclosure credentials.',
    href: '/tutorials/snarkjs-interop/',
    cta: 'Interop tutorial',
  },
];

const useCases = [
  { glyph: '☑', title: 'Private voting', text: 'Prove you may vote and vote once — without revealing who you are.', href: '/use-cases/private-voting/' },
  { glyph: '⚖', title: 'Proof of reserves', text: 'Show reserves cover liabilities without exposing a single balance.', href: '/use-cases/proof-of-reserves/' },
  { glyph: '18+', title: 'Age & KYC checks', text: 'Pass an eligibility check without handing over your documents.', href: '/use-cases/age-and-kyc/' },
  { glyph: '◈', title: 'Private NFT ownership', text: 'Prove you hold an asset from a collection without doxxing your wallet.', href: '/use-cases/nft-ownership/' },
  { glyph: '1×', title: 'One claim per person', text: 'Sybil-resistant airdrops with nullifiers instead of identity leaks.', href: '/use-cases/sybil-resistant-airdrop/' },
  { glyph: '◐', title: 'Selective disclosure', text: 'Reveal only the credential attributes a service needs, verified on-chain.', href: '/use-cases/selective-disclosure/' },
  { glyph: '⛓', title: 'Product passports', text: 'Prove compliance of a product without exposing the supply chain.', href: '/use-cases/digital-product-passport/' },
  { glyph: '⚿', title: 'Account recovery', text: 'Prove you control a Cardano key without revealing the seed.', href: '/use-cases/account-recovery/' },
];

const scenarios = [
  {
    id: 'age',
    label: 'Age check',
    statement: 'age ≥ 18',
    fields: [
      { name: 'age', value: '27', secret: true },
      { name: 'threshold', value: '18', secret: false },
    ],
  },
  {
    id: 'allowlist',
    label: 'Allowlist',
    statement: 'I am on the list — and haven’t claimed yet',
    fields: [
      { name: 'memberSecret', value: '0x51c0…9ae4', secret: true },
      { name: 'merklePath', value: '[20 sibling hashes]', secret: true },
      { name: 'listRoot', value: '0x1f9c…04b7', secret: false },
      { name: 'nullifier', value: '0x77ab…e210', secret: false },
    ],
  },
  {
    id: 'reserves',
    label: 'Reserves',
    statement: 'Σ balances ≥ liabilities',
    fields: [
      { name: 'balances', value: '[120 450, 80 300, 61 900] ₳', secret: true },
      { name: 'liabilities', value: '250 000 ₳', secret: false },
    ],
  },
];

const aiPrompt = `Read ${SITE_URL}/llms.txt and ${SITE_URL}/ai/starter-pack.md.
Using ZeroJ (Groth16, BLS12-381), write a @ZKCircuit that proves a
secret balance is at least a public threshold, a JUnit test with a
valid and an invalid witness, and the code to verify the proof in Java.`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ZeroJ — Zero-knowledge proofs for the JVM</title>
    <meta
      name="description"
      content="ZeroJ is a Java-first zero-knowledge toolkit for Cardano. Define circuits in Java, prove with a pure-Java Groth16 prover, and verify in any JVM or on Cardano."
    />
    <meta name="theme-color" content="#ffffff" />
    <link rel="canonical" href={`${SITE_URL}/`} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />
    <meta property="og:title" content="ZeroJ — Zero-knowledge proofs for the JVM" />
    <meta
      property="og:description"
      content="Prove a fact without revealing the data. Circuits in Java, a pure-Java Groth16 prover, verification in Java and on Cardano."
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`${SITE_URL}/`} />
    <meta property="og:image" content={`${SITE_URL}/social.png`} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="site-header">
      <a class="brand" href="/" aria-label="ZeroJ home">
        <img src="/zeroj-icon.svg" width="34" height="34" alt="" />
        <span class="wordmark">zeroj</span>
        <span class="brand-slash" aria-hidden="true">/</span>
        <span class="brand-caption">ZK FOR THE JVM</span>
      </a>
      <button class="menu-toggle" aria-expanded="false" aria-controls="nav">
        Menu <span aria-hidden="true">＋</span>
      </button>
      <nav id="nav" aria-label="Main navigation">
        <a href="/start/overview/">Docs</a>
        <a href="/learn/zero-knowledge-basics/">Learn ZK</a>
        <a href="/use-cases/overview/">Use cases</a>
        <a href="/ai/">For AI <span class="spark" aria-hidden="true">✧</span></a>
        <a class="github" href={REPO_URL}>GitHub <span aria-hidden="true">↗</span></a>
      </nav>
    </header>

    <main id="main">
      <!-- ============================================================ HERO -->
      <section class="hero wrap">
        <div class="hero-copy">
          <a class="pill" href="/start/status/">
            <span class="status-dot"></span> EXPERIMENTAL · OPEN SOURCE · MIT
            <span aria-hidden="true">↗</span>
          </a>
          <h1>
            <span class="nowrap">Zero-knowledge</span> proofs,
            <span class="grad">in plain Java.</span>
          </h1>
          <p class="lede">
            Prove a fact without revealing the data behind it. Define circuits as Java classes, prove
            them with a pure-Java Groth16 prover, and verify the proof anywhere — in your JVM or on
            Cardano.
          </p>
          <div class="hero-actions">
            <a class="button primary" href="/start/quickstart/">
              Build your first proof <span aria-hidden="true">↗</span>
            </a>
            <a class="button secondary" href="/learn/zero-knowledge-basics/">
              New to ZK? Start here <span aria-hidden="true">→</span>
            </a>
          </div>
          <div class="install">
            <span class="install-label">GRADLE</span>
            <code>{install}</code>
            <button class="copy-inline" data-copy={install} aria-label="Copy Gradle dependency">
              Copy
            </button>
          </div>
          <ul class="hero-footnote" aria-label="Highlights">
            <li>JAVA 25</li>
            <li>PURE-JAVA PROVER</li>
            <li>GROTH16 · BLS12-381</li>
            <li>CARDANO PLUTUS V3</li>
          </ul>
        </div>

        <div
          class="proof-visual"
          role="img"
          aria-label="A prover who knows a secret age of 27 sends a 192-byte proof to a verifier, who learns only that the age is at least 18."
        >
          <div class="pv-top">
            <span>ZK PROOF · GROTH16 · BLS12-381</span>
            <span class="live"><i></i> LIVE</span>
          </div>
          <div class="pv-stage" aria-hidden="true">
            <div class="party prover">
              <small>PROVER · KNOWS</small>
              <dl>
                <div>
                  <dt>age</dt>
                  <dd><b>27</b> <em class="tag secret">SECRET</em></dd>
                </div>
                <div>
                  <dt>threshold</dt>
                  <dd><b>18</b> <em class="tag public">PUBLIC</em></dd>
                </div>
              </dl>
            </div>

            <div class="engine">
              <svg viewBox="0 0 128 128" class="rings">
                <g class="ring r1">
                  <path d="M116.28 43.93A56 56 0 1 1 29.76 19.69"></path>
                </g>
                <g class="ring r2">
                  <path d="M45.87 98.53A39 39 0 1 1 94.31 39.46"></path>
                </g>
                <g class="ring r3">
                  <path d="M55.21 43.29A22.5 22.5 0 0 1 80.18 79.63"></path>
                </g>
                <circle cx="64" cy="64" r="5.5" class="core-dot"></circle>
              </svg>
              <span class="engine-label">PROVE</span>
            </div>

            <div class="party verifier">
              <small>VERIFIER · SEES</small>
              <dl>
                <div>
                  <dt>age</dt>
                  <dd><span class="masked">••</span> <em class="tag hidden-tag">HIDDEN</em></dd>
                </div>
                <div>
                  <dt>threshold</dt>
                  <dd><b>18</b></dd>
                </div>
              </dl>
              <div class="verdict"><span>✓</span> age ≥ 18</div>
            </div>

            <div class="beam beam-in"></div>
            <div class="beam beam-out"></div>
          </div>
          <div class="pv-proof">
            <span class="pv-proof-label">π</span>
            <code data-proof-bytes>8f3a1c…e04d</code>
            <span class="pv-proof-size">192 BYTES</span>
          </div>
          <div class="pv-bottom">
            <span>Fresh randomness on every proof — same statement, new bytes.</span>
          </div>
        </div>
      </section>

      <div class="tech-strip">
        <div class="wrap">
          <span class="strip-label">BUILT ON<br /><strong>OPEN STANDARDS</strong></span>
          <ul>
            <li>Java 25</li>
            <li>Groth16</li>
            <li>BLS12-381</li>
            <li>Plutus V3</li>
            <li>Poseidon</li>
          </ul>
        </div>
      </div>

      <!-- ============================================================ CONCEPT -->
      <section class="concept wrap" id="concept">
        <div class="section-heading">
          <div>
            <p class="eyebrow">/ ZERO-KNOWLEDGE, IN ONE PICTURE</p>
            <h2>Prove the fact.<br /><span>Keep the data.</span></h2>
          </div>
          <p>
            A zero-knowledge proof convinces a verifier that a statement about your data is true —
            and reveals nothing else. Flip the view to see what each side actually learns.
          </p>
        </div>

        <div class="concept-card">
          <div class="concept-controls">
            <div class="scenario-tabs" role="tablist" aria-label="Example statements">
              {
                scenarios.map((s, i) => (
                  <button
                    role="tab"
                    id={`sc-tab-${s.id}`}
                    aria-controls={`sc-panel-${s.id}`}
                    aria-selected={i === 0 ? 'true' : 'false'}
                    tabindex={i === 0 ? 0 : -1}
                    data-scenario={s.id}
                  >
                    {s.label}
                  </button>
                ))
              }
            </div>
            <div class="view-switch" role="group" aria-label="Choose a point of view">
              <button class="view-btn" aria-pressed="true" data-view="prover">Prover’s view</button>
              <button class="view-btn" aria-pressed="false" data-view="verifier">Verifier’s view</button>
            </div>
          </div>

          <div class="concept-body" data-view-state="prover">
            {
              scenarios.map((s, i) => (
                <div
                  class="scenario"
                  id={`sc-panel-${s.id}`}
                  role="tabpanel"
                  aria-labelledby={`sc-tab-${s.id}`}
                  hidden={i !== 0}
                >
                  <table>
                    <thead>
                      <tr>
                        <th scope="col">Input</th>
                        <th scope="col">Value</th>
                        <th scope="col">Visibility</th>
                      </tr>
                    </thead>
                    <tbody>
                      {s.fields.map((f) => (
                        <tr class={f.secret ? 'is-secret' : 'is-public'}>
                          <td>
                            <code>{f.name}</code>
                          </td>
                          <td>
                            <span class="val">{f.value}</span>
                            <span class="val-masked" aria-hidden="true">
                              ████████
                            </span>
                          </td>
                          <td>
                            <em class={`tag ${f.secret ? 'secret' : 'public'}`}>
                              {f.secret ? 'SECRET' : 'PUBLIC'}
                            </em>
                          </td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                  <div class="statement">
                    <span class="statement-label">STATEMENT</span>
                    <strong>{s.statement}</strong>
                    <span class="statement-result">✓ proven</span>
                  </div>
                </div>
              ))
            }
            <p class="view-caption" aria-live="polite">
              <span class="cap-prover">
                The prover holds every value and runs the circuit to produce a proof.
              </span>
              <span class="cap-verifier">
                The verifier sees only public inputs and a ~192-byte proof — yet is convinced the
                statement is true.
              </span>
            </p>
          </div>
        </div>
        <a class="text-link" href="/learn/zero-knowledge-basics/">
          Zero-knowledge in plain English <span aria-hidden="true">→</span>
        </a>
      </section>

      <!-- ============================================================ PIPELINE -->
      <section class="pipeline wrap" id="how">
        <div class="section-heading">
          <div>
            <p class="eyebrow">/ HOW IT WORKS</p>
            <h2>From a Java class<br /><span>to a Cardano validator.</span></h2>
          </div>
          <p>
            One circuit, four steps, all in Java. Start with a unit test on your laptop; end with a
            proof verified by Plutus V3.
          </p>
        </div>
        <div class="workflow-tabs" role="tablist" aria-label="ZeroJ workflow">
          {
            pipeline.map((step, i) => (
              <button
                role="tab"
                id={`tab-${step.id}`}
                aria-controls={`panel-${step.id}`}
                aria-selected={i === 0 ? 'true' : 'false'}
                tabindex={i === 0 ? 0 : -1}
                data-tab={step.id}
              >
                <span>{step.number}</span>
                {step.label}
              </button>
            ))
          }
        </div>
        {
          pipeline.map((step, i) => (
            <div
              class="workflow-panel"
              id={`panel-${step.id}`}
              role="tabpanel"
              aria-labelledby={`tab-${step.id}`}
              hidden={i !== 0}
              tabindex="0"
            >
              <div class="workflow-copy">
                <span class="tiny-label">
                  {step.number} / {step.label.toUpperCase()}
                </span>
                <h3>{step.title}</h3>
                <p>{step.text}</p>
                <a class="text-link" href={step.href}>
                  {step.cta} <span aria-hidden="true">→</span>
                </a>
              </div>
              <div class="code-window">
                <div class="code-title">
                  <span class="dots">
                    <i />
                    <i />
                    <i />
                  </span>
                  <span>{step.file}</span>
                  <button class="copy-code" data-copy={step.code} aria-label={`Copy ${step.label} example`}>
                    Copy
                  </button>
                </div>
                <Code code={step.code} lang="java" theme="github-dark" />
                <div class="code-note">{step.note}</div>
              </div>
            </div>
          ))
        }
      </section>

      <!-- ============================================================ FEATURES -->
      <section class="features wrap">
        <div class="section-heading">
          <div>
            <p class="eyebrow">/ THE TOOLKIT</p>
            <h2>Serious cryptography.<br /><span>Familiar Java.</span></h2>
          </div>
          <a class="text-link" href="/start/overview/">
            Explore the docs <span aria-hidden="true">↗</span>
          </a>
        </div>
        <div class="feature-grid">
          {
            features.map((f) => (
              <a class="feature" href={f.href}>
                <span class="feature-glyph" aria-hidden="true">
                  {f.glyph}
                </span>
                <h3>{f.title}</h3>
                <p>{f.text}</p>
                <span class="feature-link">
                  {f.cta} <span aria-hidden="true">→</span>
                </span>
              </a>
            ))
          }
        </div>
      </section>

      <!-- ============================================================ USE CASES -->
      <section class="usecases wrap" id="use-cases">
        <div class="section-heading">
          <div>
            <p class="eyebrow">/ WHAT WILL YOU BUILD?</p>
            <h2>Privacy that apps<br /><span>can actually verify.</span></h2>
          </div>
          <p>
            Every idea below has a design walkthrough, and most have a runnable end-to-end demo on a
            local Cardano devnet.
          </p>
        </div>
        <div class="usecase-grid">
          {
            useCases.map((u) => (
              <a class="usecase" href={u.href}>
                <span class="usecase-glyph" aria-hidden="true">
                  {u.glyph}
                </span>
                <h3>{u.title}</h3>
                <p>{u.text}</p>
                <span class="usecase-arrow" aria-hidden="true">
                  ↗
                </span>
              </a>
            ))
          }
        </div>
        <div class="usecase-foot">
          <a class="text-link" href="/use-cases/overview/">
            All use cases & ideas <span aria-hidden="true">→</span>
          </a>
          <a class="text-link muted" href={USECASES_URL}>
            Runnable demos on GitHub <span aria-hidden="true">↗</span>
          </a>
        </div>
      </section>

      <!-- ============================================================ LEARNING PATH -->
      <section class="path wrap">
        <div class="section-heading">
          <div>
            <p class="eyebrow">/ YOUR LEARNING PATH</p>
            <h2>From zero to on-chain,<br /><span>one step at a time.</span></h2>
          </div>
          <p>No cryptography background needed. If you can write a unit test, you can write a circuit.</p>
        </div>
        <ol class="path-steps">
          <li>
            <span class="path-time">≈ 15 MIN</span>
            <h3>Understand the idea</h3>
            <p>Provers, verifiers, circuits and witnesses — in plain English, with Java analogies.</p>
            <a href="/learn/zero-knowledge-basics/">Learn ZK <span aria-hidden="true">→</span></a>
          </li>
          <li>
            <span class="path-time">≈ 10 MIN</span>
            <h3>Make your first proof</h3>
            <p>A runnable Gradle project: define, prove and verify a secret in pure Java.</p>
            <a href="/start/quickstart/">Quickstart <span aria-hidden="true">→</span></a>
          </li>
          <li>
            <span class="path-time">≈ 1 HOUR</span>
            <h3>Build real statements</h3>
            <p>Range proofs, private allowlists with nullifiers, and on-chain verification.</p>
            <a href="/tutorials/age-check/">Tutorials <span aria-hidden="true">→</span></a>
          </li>
          <li>
            <span class="path-time">ONGOING</span>
            <h3>Ship responsibly</h3>
            <p>Replay protection, trusted setup ceremonies and a security checklist for ZK apps.</p>
